# Public browser configuration (never put server secrets under VITE_).
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLIC_KEY
VITE_GOOGLE_CLIENT_ID=YOUR_CLIENT_ID.apps.googleusercontent.com
VITE_GOOGLE_API_KEY=YOUR_RESTRICTED_BROWSER_API_KEY
VITE_GOOGLE_APP_ID=YOUR_NUMERIC_GOOGLE_CLOUD_PROJECT_NUMBER
# Student accounts: every two-digit admission year at this domain is accepted.
VITE_SCHOOL_EMAIL_DOMAIN=gochon.hs.kr
VITE_STUDENT_ADMISSION_YEAR=26
# Server only; configure in Vercel and locally in .env.local.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLIC_KEY
NVIDIA_API_KEY=YOUR_NEW_SERVER_ONLY_KEY
